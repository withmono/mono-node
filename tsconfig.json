{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "module": "CommonJS",
    "allowJs": true,
    "target": "es2019",
    "alwaysStrict": true,
    "strict": false,
    "removeComments": false,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "isolatedModules": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/test.ts", "src/implementation.ts", "**/*.test.ts"]
}
