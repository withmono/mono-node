{
  "compilerOptions": {
    "outDir": "./dist",
    "module": "CommonJS",
    "allowJs": true,
    "target": "es2019",
    "alwaysStrict": true,
    "strict": false,
    "removeComments": false,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "isolatedModules": true
  },
  "include": ["./**/*"]
}
